{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist",
    "node_modules",
    "storybook-static",
    "*.log",
    "coverage",
    "package-lock.json",
    "CHANGELOG.md",
    "graphify-out"
  ],
  "sortImports": true
}
